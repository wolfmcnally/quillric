#!/usr/bin/env python3
"""Symlinkable launcher: run the checkout's transcribe package with no install step."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from transcribe.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
